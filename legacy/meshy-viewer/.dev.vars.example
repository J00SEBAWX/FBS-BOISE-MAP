# Copy this file to .dev.vars for local development with `npm run dev`.
# .dev.vars is gitignored — never commit real keys.
#
# For production, set these as secrets on the Worker instead
# (Cloudflare dashboard -> Workers & Pages -> fbs-boise-map -> Settings
# -> Variables and Secrets -> add as "Secret", or
# `wrangler secret put <NAME>`).

MESHY_API_KEY=msy_your_key_here

# Optional. If set, the /api/meshy/* endpoints require this value back
# as an X-Access-Code header (see src/access.js).
# Leave unset during early local dev if you don't want the prompt.
SITE_ACCESS_CODE=
