# Local development only. Copy to .dev.vars (git-ignored) and fill in with throwaway values.
# Production values are set with `wrangler secret put` (npm run go-live does this for you).
PEPPER=replace-with-64-random-hex-characters-0000000000000000000000000000
PHONE_KEY=replace-with-base64-of-32-random-bytes=
# Optional: push alerts through ntfy (leave unset locally)
# NTFY_TOPIC=fbs-your-private-topic
# Optional: Meshy text-to-3D proxy (admin only)
# MESHY_API_KEY=
# SITE_ACCESS_CODE=
